# /etc/usb-cloner/cloner.conf  (sourced by bash)

# Physical port(s) that hold the MASTER drive. Set by `usb-cloner-map`.
# Everything else on USB is treated as a blank and will be overwritten.
MASTER_PORTS=""

# How a batch starts. In every mode `sudo usb-cloner go` (e.g. over SSH)
# also starts the current batch.
#   master    - blanks in first, then insert the master. The master going in
#               is the "go". Starts AUTOSTART_SECONDS later; pulling a drive
#               in that window aborts. If the master was in before the blanks,
#               pull it and reinsert. Never starts by itself after a reboot.
#   countdown - starts AUTOSTART_SECONDS after the drive set stops changing,
#               in any order. Convenient, but a slow hand inserting blanks can
#               start a batch early.
#   enter     - wait for Enter on a keyboard.
TRIGGER=master
AUTOSTART_SECONDS=5

# Read back every target and compare its hash to the master's. Keep this on.
VERIFY=1

BLOCK_SIZE=4M
LOG_DIR=/var/log/usb-cloner

# SCSI command timeout, in seconds, applied to every drive in a batch (the
# kernel default is 30). A stick that stops answering is retried for several
# timeouts before the kernel drops it, and the whole batch waits meanwhile:
# 30 s means about four minutes of nothing on screen, 10 s about one.
DEVICE_TIMEOUT=10

# Optional hook for a light, a push message or a beep. Run in the background
# as:  NOTIFY_CMD <state> <text>   with state one of
#   running | verifying | pass | fail | idle
# See notify.example.sh for a USB light (blink(1)), ntfy push and a beep.
#NOTIFY_CMD=/etc/usb-cloner/notify.sh

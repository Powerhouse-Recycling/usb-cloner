#!/usr/bin/env bash
# usb-cloner: sector-for-sector USB flash drive duplicator.
#
# Master drive goes in the mapped master port (front of the M70q).
# Blank drives go in any other USB port. The master is read exactly once
# and the stream is fanned out to every target at the same time, then every
# target is read back and compared against the master's hash.
#
# No images are stored. Runs as an interactive console loop on tty1.

set -euo pipefail

CONF=/etc/usb-cloner/cloner.conf
MASTER_PORTS=""        # space-separated sysfs port keys, set by usb-cloner-map
HW_ID=""               # machine the ports were mapped on, set by usb-cloner-map
TRIGGER=master         # master | countdown | enter   (see cloner.conf.example)
AUTOSTART_SECONDS=5    # grace period before an automatic start
BLOCK_SIZE=4M
VERIFY=1
LOG_DIR=/var/log/usb-cloner
GO_FILE=/run/usb-cloner/go   # `usb-cloner go` touches this to start the batch
load_conf() {
    # shellcheck disable=SC1090
    [[ -r $CONF ]] && . "$CONF"
    return 0
}
load_conf

# Ubuntu 25.10+ ships the Rust coreutils rewrite as dd. Its 0.8.0 fails every
# iflag=direct read with EINVAL and ignores count_bytes. GNU dd is installed
# alongside as gnudd; prefer it. Reads for verification avoid dd entirely.
DD=$(command -v gnudd || command -v dd)

# `usb-cloner go`: start the current batch from another shell (e.g. over SSH).
if [[ ${1:-} == go ]]; then
    [[ $EUID -eq 0 ]] || { echo "must run as root: sudo usb-cloner go" >&2; exit 1; }
    mkdir -p "$(dirname "$GO_FILE")" && touch "$GO_FILE" && echo "go signalled"
    exit 0
fi

TMP=""
BG_PIDS=()

# Keyboard interrupts on the console must not kill the appliance
# (Ctrl-C mid-write would leave half-written drives reported as nothing).
trap '' INT QUIT TSTP

cleanup() {
    local p
    for p in "${BG_PIDS[@]:-}"; do
        [[ -n $p ]] && kill "$p" 2>/dev/null || true
    done
    [[ -n $TMP && -d $TMP ]] && rm -rf "$TMP"
}
trap cleanup EXIT

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# ---------- device discovery ----------

# Every whole-disk block device attached over USB.
usb_disks() {
    lsblk -dnpo NAME,TRAN,TYPE | awk '$2 == "usb" && $3 == "disk" { print $1 }'
}

# Physical port the device sits in, as "usb<bus>/<bus>-<port[.port]>", taken
# from the sysfs path, e.g. usb2/2-3. The USB 2.0 and USB 3.x sides of one
# socket are different ports on different buses (usb1/1-2 vs usb2/2-3).
# ID_PATH is NOT used: it drops the bus number, so a USB 2.0 stick in a rear
# port can collide with the master's path.
port_of() {
    udevadm info -q property -n "$1" 2>/dev/null \
        | sed -n 's|^DEVPATH=.*/\(usb[0-9]*/[0-9]*-[0-9.]*\)/.*|\1|p'
}

is_master_port() {
    local p want
    for want in $MASTER_PORTS; do
        [[ $1 == "$want" ]] && return 0
    done
    return 1
}

# True if the disk or any partition on it is mounted or in use as swap.
in_use() {
    lsblk -no MOUNTPOINT "$1" 2>/dev/null | grep -q . && return 0
    lsblk -no FSTYPE "$1" 2>/dev/null | grep -qx swap && swapon --show=NAME --noheadings | grep -q "^$1" && return 0
    return 1
}

size_of()  { blockdev --getsize64 "$1"; }
model_of() { lsblk -dno VENDOR,MODEL "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //;s/ $//'; }
human()    { numfmt --to=iec --suffix=B "$1"; }

# Fills MASTER, MASTER_PORT, TARGETS[], TARGET_PORTS[], NOTES[].
scan() {
    MASTER=""; MASTER_PORT=""
    TARGETS=(); TARGET_PORTS=(); NOTES=()
    local d p
    for d in $(usb_disks); do
        p=$(port_of "$d")
        if is_master_port "$p"; then
            if [[ -n $MASTER ]]; then
                NOTES+=("Two drives found in master ports ($MASTER, $d). Remove one.")
                continue
            fi
            MASTER=$d; MASTER_PORT=$p
        else
            TARGETS+=("$d"); TARGET_PORTS+=("$p")
        fi
    done
}

# ---------- UI ----------

hw_id() {
    cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name /sys/class/dmi/id/product_version 2>/dev/null \
        | tr -s ' \n' ' ' | sed 's/ $//'
}

banner() {
    clear
    printf '=== USB CLONER ===  master socket -> all other USB sockets, sector for sector\n'
    printf 'Machine: %s    IP: %s    Master ports: %s\n' "$(hw_id)" "$(hostname -I 2>/dev/null | awk '{print $1}')" "${MASTER_PORTS:-NONE MAPPED}"
    case $TRIGGER in
        master)    printf 'Start: blanks in first, then insert the master (or: usb-cloner go)\n\n' ;;
        countdown) printf 'Start: automatically %ds after the last drive is inserted (or: usb-cloner go)\n\n' "$AUTOSTART_SECONDS" ;;
        *)         printf 'Start: press ENTER (or: usb-cloner go)\n\n' ;;
    esac
}

# Prints the current plan. Sets ELIGIBLE[] (indices into TARGETS that can be written).
show_plan() {
    local msize i d sz
    ELIGIBLE=()
    if [[ -z $MASTER ]]; then
        printf 'MASTER:  (waiting for a drive in the master port)\n'
    else
        msize=$(size_of "$MASTER")
        printf 'MASTER:  %-10s %-9s %s  [%s]\n' "$MASTER" "$(human "$msize")" "$(model_of "$MASTER")" "$MASTER_PORT"
        if in_use "$MASTER"; then
            printf '         !! master is mounted. Refusing to continue.\n'
            MASTER=""
        fi
    fi
    printf '\nTARGETS:\n'
    if (( ${#TARGETS[@]} == 0 )); then
        printf '  (none inserted)\n'
    fi
    for i in "${!TARGETS[@]}"; do
        d=${TARGETS[$i]}; sz=$(size_of "$d")
        printf '  %-10s %-9s %-28.28s [%s]' "$d" "$(human "$sz")" "$(model_of "$d")" "${TARGET_PORTS[$i]}"
        if in_use "$d"; then
            printf '  SKIP: mounted\n'
        elif [[ -n $MASTER && $sz -lt $msize ]]; then
            printf '  SKIP: smaller than master\n'
        else
            printf '  ready\n'
            ELIGIBLE+=("$i")
        fi
    done
    local n
    for n in "${NOTES[@]:-}"; do [[ -n $n ]] && printf '\n!! %s\n' "$n"; done
    printf '\n'
}

plan_signature() {
    printf '%s|%s' "$MASTER" "${TARGETS[*]:-}"
}

go_signalled() {
    [[ -e $GO_FILE ]] || return 1
    rm -f "$GO_FILE"
    printf '\nstart requested via usb-cloner go\n'
    return 0
}

# Wait until the batch should start. Re-scans every second so drives can be
# added or removed while waiting. Returns 0 to start, 1 if the set changed.
#   auto=1: count down AUTOSTART_SECONDS, then start.
#   auto=0: wait for Enter or `usb-cloner go` only.
wait_for_go() {
    local auto=$1 sig left
    sig=$(plan_signature)
    left=$AUTOSTART_SECONDS
    while true; do
        go_signalled && return 0
        if (( auto )); then
            printf '\rStarting in %2ds (remove a drive to abort) ... ' "$left"
            if (( left <= 0 )); then printf '\n'; return 0; fi
        else
            printf '\rWaiting (%d drive(s) ready). ' "${#ELIGIBLE[@]}"
        fi
        if read -r -t 1; then printf '\n'; return 0; fi
        scan
        [[ $(plan_signature) != "$sig" ]] && return 1
        (( left-- )) || true
    done
}

# ---------- cloning ----------

clone_all() {
    local msize i d fifos=() wpids=() rc=0 start
    msize=$(size_of "$MASTER")
    TMP=$(mktemp -d /tmp/usb-cloner.XXXXXX)
    RESULT=()

    printf 'Cloning %s (%s) to %d drive(s)...\n' "$MASTER" "$(human "$msize")" "${#ELIGIBLE[@]}"
    start=$(date +%s)

    # One writer process per target, each fed from its own FIFO.
    for i in "${ELIGIBLE[@]}"; do
        d=${TARGETS[$i]}
        mkfifo "$TMP/t$i"
        fifos+=("$TMP/t$i")
        "$DD" of="$d" bs="$BLOCK_SIZE" iflag=fullblock oflag=direct conv=fsync status=none < "$TMP/t$i" 2>"$TMP/w$i.err" &
        wpids[i]=$!
        BG_PIDS+=("$!")
    done
    # One more consumer hashes the master stream so verify never re-reads it.
    mkfifo "$TMP/hash"
    sha256sum < "$TMP/hash" | cut -d' ' -f1 > "$TMP/master.sha" &
    BG_PIDS+=("$!")

    # Single read of the master, fanned out. tee -p keeps going if one
    # writer dies; that target is reported failed from its exit status.
    if command -v pv >/dev/null; then
        pv -s "$msize" -N master "$MASTER" | tee -p "${fifos[@]}" "$TMP/hash" > /dev/null || rc=$?
    else
        "$DD" if="$MASTER" bs="$BLOCK_SIZE" iflag=fullblock status=progress | tee -p "${fifos[@]}" "$TMP/hash" > /dev/null || rc=$?
    fi
    (( rc != 0 )) && printf '!! read error on master (exit %d). Results below are unreliable.\n' "$rc"

    for i in "${ELIGIBLE[@]}"; do
        if wait "${wpids[$i]}"; then
            RESULT[i]=written
        else
            RESULT[i]="WRITE FAILED: $(tail -n1 "$TMP/w$i.err" 2>/dev/null | cut -c1-60)"
        fi
    done
    wait
    sync
    MASTER_SHA=$(cat "$TMP/master.sha")
    printf 'Write phase done in %ds. master sha256 %s\n' "$(( $(date +%s) - start ))" "${MASTER_SHA:0:16}..."

    for i in "${ELIGIBLE[@]}"; do
        blockdev --rereadpt "${TARGETS[$i]}" 2>/dev/null || true
    done
}

verify_all() {
    local msize i d vpids=() start n=0
    msize=$(size_of "$MASTER")
    start=$(date +%s)
    for i in "${ELIGIBLE[@]}"; do
        [[ ${RESULT[$i]} == written ]] || continue
        d=${TARGETS[$i]}
        # Drop this device's cached blocks so the read comes from the flash.
        # (Writes were O_DIRECT so there is little cached anyway.)
        blockdev --flushbufs "$d"
        head -c "$msize" "$d" 2>"$TMP/v$i.err" | sha256sum | cut -d' ' -f1 > "$TMP/v$i" &
        vpids[i]=$!
        BG_PIDS+=("$!")
        n=$((n + 1))
    done
    printf 'Verifying %d drive(s), reading back %s from each' "$n" "$(human "$msize")"
    while :; do
        local running=0
        for i in "${!vpids[@]}"; do kill -0 "${vpids[$i]}" 2>/dev/null && running=1; done
        (( running )) || break
        printf '.'
        sleep 5
    done
    printf '\n'
    for i in "${!vpids[@]}"; do
        wait "${vpids[$i]}" || true
        if [[ $(cat "$TMP/v$i") == "$MASTER_SHA" ]]; then
            RESULT[i]=PASS
        else
            RESULT[i]="VERIFY FAILED: $(tail -n1 "$TMP/v$i.err" 2>/dev/null | cut -c1-60)"
            RESULT[i]=${RESULT[$i]%: }
        fi
    done
    printf 'Verify done in %ds.\n' "$(( $(date +%s) - start ))"
}

report() {
    local i d line ts log
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    mkdir -p "$LOG_DIR"
    log="$LOG_DIR/$(date +%Y-%m).log"
    printf '\n%-10s %-30s %s\n' DEVICE PORT RESULT
    for i in "${ELIGIBLE[@]}"; do
        d=${TARGETS[$i]}
        line=$(printf '%-10s %-30s %s' "$d" "${TARGET_PORTS[$i]}" "${RESULT[$i]}")
        printf '%s\n' "$line"
        printf '%s master=%s(%s) sha=%s %s\n' "$ts" "$(model_of "$MASTER")" "$(human "$(size_of "$MASTER")")" "${MASTER_SHA:0:16}" "$line" >> "$log"
    done
    local fails
    fails=$(printf '%s\n' "${RESULT[@]}" | grep -vc '^PASS' || true)
    printf '\n'
    if (( fails == 0 )); then
        printf '>>> ALL %d PASSED <<<\n' "${#ELIGIBLE[@]}"
    else
        printf '>>> %d FAILED - discard those drives <<<\n' "$fails"
    fi
}

wait_until_targets_removed() {
    local d still
    printf '\nRemove the cloned drives to start the next batch.\n'
    while :; do
        still=0
        for d in "${TARGETS[@]}"; do [[ -b $d ]] && still=1; done
        (( still )) || break
        sleep 1
    done
}

# ---------- main loop ----------

[[ $EUID -eq 0 ]] || die "must run as root"
mkdir -p "$(dirname "$GO_FILE")"; rm -f "$GO_FILE"

# No map yet, or the drive woke up in a different machine: map the master
# socket on screen (one stick insertion, no keyboard), then carry on.
if [[ -z $MASTER_PORTS || $HW_ID != "$(hw_id)" ]]; then
    clear
    [[ -n $MASTER_PORTS ]] && printf 'Hardware changed (was: %s). The master socket must be mapped again.\n\n' "$HW_ID"
    usb-cloner-map
    load_conf
    [[ -n $MASTER_PORTS ]] || die "mapping failed"
    sleep 2
fi

# TRIGGER=master: "armed" means the master has been absent since the last
# batch, so its next appearance is a deliberate "go". Starts disarmed, so a
# reboot with everything plugged in never clones on its own.
armed=0

while true; do
    # Wait for a master and at least one eligible target.
    while :; do
        scan
        banner
        show_plan
        [[ -z $MASTER ]] && armed=1
        if [[ -n $MASTER && ${#ELIGIBLE[@]} -gt 0 ]]; then
            if [[ $TRIGGER == master && $armed -eq 0 ]]; then
                printf 'Master was inserted before the blanks. Remove it and insert it again to start.\n'
                go_signalled && break
            else
                break
            fi
        fi
        sleep 1
    done

    case $TRIGGER in
        master|countdown) wait_for_go 1 || continue ;;
        *)                wait_for_go 0 || continue ;;
    esac
    armed=0

    clone_all
    if (( VERIFY )); then
        verify_all
    else
        for i in "${ELIGIBLE[@]}"; do [[ ${RESULT[$i]} == written ]] && RESULT[i]="PASS (unverified)"; done
    fi
    report
    rm -rf "$TMP"; TMP=""; BG_PIDS=()
    wait_until_targets_removed
done

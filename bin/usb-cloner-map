#!/usr/bin/env bash
# usb-cloner-map: record which physical USB socket is the MASTER socket.
#
# Keyboard-free. Remove every USB drive, insert one into the master socket,
# done. The cloner identifies sockets by USB bus and port from sysfs, never
# by /dev name. One socket is two ports (its USB 3.x side and its USB 2.0
# side, on different buses); the kernel links them as "peer", so one
# insertion maps both. The machine's DMI identity is stored with the map,
# and the cloner re-runs this when the drive wakes up in different hardware.
#
# Called by the cloner service on tty1 when needed; also fine over SSH.

set -euo pipefail

CONF=/etc/usb-cloner/cloner.conf
[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
mkdir -p "$(dirname "$CONF")"
touch "$CONF"

usb_disks() { lsblk -dnpo NAME,TRAN,TYPE | awk '$2 == "usb" && $3 == "disk" { print $1 }'; }

# "usb<bus>/<bus>-<port>" from the sysfs path, e.g. usb2/2-3.
port_of() {
    udevadm info -q property -n "$1" \
        | sed -n 's|^DEVPATH=.*/\(usb[0-9]*/[0-9]*-[0-9.]*\)/.*|\1|p'
}

# USB link speed in Mbit/s (480 = USB 2.0, 5000/10000 = USB 3.x).
speed_of() {
    local s
    s=/sys$(udevadm info -q path -n "$1")
    while [[ $s != / && ! -r $s/speed ]]; do s=$(dirname "$s"); done
    [[ -r $s/speed ]] && cat "$s/speed" || echo "?"
}

# The other side of the same physical socket, via the kernel's port "peer"
# link. Root-hub ports only; prints nothing for ports behind a hub.
peer_of() {
    local key=$1 bus port dir peer
    bus=${key%%/*}                      # usb2
    port=${key#*/}; port=${port#*-}     # 3   (or 3.4 behind a hub)
    [[ $port == *.* ]] && return 0
    dir=/sys/bus/usb/devices/$bus/${bus#usb}-0:1.0/$bus-port$port
    [[ -L $dir/peer ]] || return 0
    peer=$(basename "$(readlink "$dir/peer")")   # usb1-port2
    [[ $peer =~ ^(usb[0-9]+)-port([0-9]+)$ ]] || return 0
    printf '%s/%s-%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[1]#usb}" "${BASH_REMATCH[2]}"
}

hw_id() {
    cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name /sys/class/dmi/id/product_version 2>/dev/null \
        | tr -s ' \n' ' ' | sed 's/ $//'
}

set_conf() {   # set_conf KEY VALUE
    if grep -q "^$1=" "$CONF"; then
        sed -i "s|^$1=.*|$1=\"$2\"|" "$CONF"
    else
        printf '%s="%s"\n' "$1" "$2" >> "$CONF"
    fi
}

echo "=== USB CLONER: map the MASTER socket ==="
echo "Machine: $(hw_id)"
echo
echo "1. Remove ALL USB drives from the machine."
while [[ -n $(usb_disks) ]]; do sleep 1; done
echo "   ok, none present."
echo "2. Insert ONE drive into the socket you want as the MASTER socket."
while :; do
    new=$(usb_disks | head -n1)
    [[ -n $new ]] && break
    sleep 1
done
sleep 1   # let udev finish
port=$(port_of "$new")
[[ -n $port ]] || { echo "could not read the sysfs port of $new" >&2; exit 1; }
peer=$(peer_of "$port")
speed=$(speed_of "$new")

ports=$port
[[ -n $peer ]] && ports="$port $peer"
set_conf MASTER_PORTS "$ports"
set_conf HW_ID "$(hw_id)"

echo "   $new is on $port (link ${speed} Mbit/s)"
if [[ -n $peer ]]; then
    echo "   the same socket's other side is $peer"
else
    echo "   no peer port found (behind a hub?). Only $port is mapped."
fi
echo "   Saved: MASTER_PORTS=\"$ports\""
echo
echo "3. Remove the drive."
while [[ -n $(usb_disks) ]]; do sleep 1; done
echo "Done."
